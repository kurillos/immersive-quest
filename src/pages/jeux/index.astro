---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../data/games';
---

<Layout
  title="Les univers de jeu"
  description="Quatre univers de jeu de rôle disponibles : Donjons & Dragons 5e, L'Appel de Cthulhu, L'Ombre du Seigneur Démon et Vampire : La Mascarade."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="font-mono text-xs tracked-caps text-gold">Le répertoire</p>
    <h1 class="mt-4 max-w-2xl font-display text-4xl text-parchment sm:text-5xl">Quatre mondes à explorer</h1>
    <p class="mt-5 max-w-2xl font-body leading-relaxed text-parchment-dim">
      Chaque univers a son ton, son rythme et son public. Cliquez sur une carte pour voir le détail — ambiance,
      format de partie, et pour qui c'est fait.
    </p>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {games.map((game) => <GameCard game={game} />)}
    </div>
  </section>
</Layout>
