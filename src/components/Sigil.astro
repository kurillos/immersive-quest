---
interface Props {
  name:
    | 'd20'
    | 'crown'
    | 'eye'
    | 'skull'
    | 'rose'
    | 'compass'
    | 'scroll'
    | 'seal'
    | 'shield';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{
  name === 'd20' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M50 4 L93 27 V73 L50 96 L7 73 V27 Z" stroke-linejoin="round" />
      <path d="M50 4 V96 M7 27 L50 50 L93 27 M7 73 L50 50 L93 73" />
    </svg>
  )
}
{
  name === 'crown' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M15 40 L30 65 L50 35 L70 65 L85 40 L78 75 H22 Z" stroke-linejoin="round" />
      <circle cx="15" cy="40" r="4" />
      <circle cx="50" cy="35" r="4" />
      <circle cx="85" cy="40" r="4" />
    </svg>
  )
}
{
  name === 'eye' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M10 50 C28 25 72 25 90 50 C72 75 28 75 10 50 Z" stroke-linejoin="round" />
      <circle cx="50" cy="50" r="13" />
      <circle cx="50" cy="50" r="4" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'skull' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M50 12 C28 12 15 28 15 48 C15 60 20 68 28 74 V85 H72 V74 C80 68 85 60 85 48 C85 28 72 12 50 12 Z" stroke-linejoin="round" />
      <circle cx="37" cy="48" r="7" />
      <circle cx="63" cy="48" r="7" />
      <path d="M45 68 H55" />
    </svg>
  )
}
{
  name === 'rose' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <circle cx="50" cy="38" r="20" />
      <circle cx="50" cy="38" r="9" />
      <path d="M50 58 C50 75 42 85 34 92 M50 58 C50 75 58 85 66 92" />
      <path d="M50 58 L50 92" />
    </svg>
  )
}
{
  name === 'compass' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <circle cx="50" cy="50" r="38" />
      <path d="M50 50 L64 32 L56 56 L36 68 Z" stroke-linejoin="round" />
      <circle cx="50" cy="50" r="3" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'scroll' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M25 20 H75 M25 20 C19 20 19 32 25 32 H75 C81 32 81 20 75 20" />
      <path d="M25 80 H75 M25 80 C19 80 19 68 25 68 H75 C81 68 81 80 75 80" />
      <path d="M25 26 V74 M75 26 V74" />
    </svg>
  )
}
{
  name === 'seal' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <circle cx="50" cy="50" r="30" />
      <circle cx="50" cy="50" r="22" stroke-dasharray="3 4" />
      <path d="M50 38 L56 48 L50 62 L44 48 Z" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'shield' && (
    <svg viewBox="0 0 100 100" fill="none" class={className} stroke="currentColor" stroke-width="1.4">
      <path d="M50 10 L82 22 V50 C82 70 68 84 50 92 C32 84 18 70 18 50 V22 Z" stroke-linejoin="round" />
      <path d="M50 30 V70 M34 46 H66" />
    </svg>
  )
}
