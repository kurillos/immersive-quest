---
import Sigil from './Sigil.astro';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/jeux', label: 'Les univers' },
  { href: '/tarifs', label: 'Tarifs' },
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="relative z-20 border-b border-white/10">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="group flex items-center gap-3">
      <Sigil name="d20" class="h-7 w-7 text-gold transition-transform duration-500 group-hover:rotate-[30deg]" />
      <span class="font-display tracked-caps text-lg text-parchment">Immersive Quest</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-mono text-xs tracked-caps transition-colors',
              isActive(link.href) ? 'text-gold' : 'text-parchment-dim hover:text-parchment',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/contact"
      class="hidden rounded-sm border border-gold/50 px-4 py-2 font-mono text-xs tracked-caps text-gold transition-colors hover:bg-gold hover:text-ink md:inline-block"
    >
      Réserver
    </a>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-sm border border-gold/40 px-3 py-2 font-mono text-xs text-gold">
        Menu
      </summary>
      <ul class="absolute right-0 top-full mt-2 w-48 space-y-1 border border-white/10 bg-ink-raised p-3 shadow-xl">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block px-2 py-2 font-mono text-xs tracked-caps text-parchment-dim hover:text-parchment">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
